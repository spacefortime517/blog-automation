# Backend connection
BACKEND_URL=https://api.pickup2.com
ACCESS_TOKEN_SECRET=<same as Server/.env>
ADMIN_USER_ID=<MongoDB ObjectId of an admin user>

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEYS=key1,key2,key3

# X/Twitter (cookies from x.com DevTools)
X_AUTH_TOKEN=
X_CT0=
X_KDT=
X_TWID=

# Facebook (Meta Pages API)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Instagram (uses same token as Facebook Page)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# LinkedIn (API - run `node src/utils/linkedin-oauth.js` to get tokens)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=
LINKEDIN_ORG_ID=

# Site
SITE_URL=https://pickup2.com
